# ==============================================================================
# BlockRun MultiversX AI Gateway & x402 Facilitator Configuration
# ==============================================================================

# HTTP Port Configuration
PORT=3000
GATEWAY_PORT=3000
FACILITATOR_PORT=3402

# MultiversX Network Identifier (CAIP-2 format)
# Mainnet: multiversx:1 | Devnet: multiversx:D | Testnet: multiversx:T
MULTIVERSX_NETWORK=multiversx:1

# MultiversX Gateway / REST API URL
# Mainnet: https://api.multiversx.com
# Devnet:  https://devnet-api.multiversx.com
MULTIVERSX_API_URL=https://api.multiversx.com

# Multi-Shard Relayer Pool Configuration
# Provide a 24-word mnemonic phrase that generates co-sharded relayers across Shards 0, 1, 2
RELAYER_MNEMONIC="twenty four words mnemonic phrase for relayer wallet pool across shards ..."

# Alternatively provide direct PEM path or PEM string:
# RELAYER_PEM_PATH=./secrets/relayers.pem
# RELAYER_PEM="-----BEGIN PRIVATE KEY for erd1...-----"

# Merchant USDC Payment Destination Address (Bech32 erd1...)
# All agent payments for AI inference are routed to this address
MERCHANT_PAY_TO=erd1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq6gq4hu

# MultiversX USDC Token Identifier
# Mainnet: USDC-c76f1f | Devnet: USDC-2a6774
USDC_TOKEN_IDENTIFIER=USDC-c76f1f

# Settlement Database Configuration
# Use a file path for persistent SQLite storage or ':memory:' for transient in-memory storage
SQLITE_DB_PATH=./data/settlements.db

# Server Security & Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Upstream AI Provider API Keys (if forwarding to live inference backends)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
UPSTREAM_TIMEOUT_MS=60000
